---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import TopBar from '../components/TopBar.astro';
import ComponentGrid from '../components/ComponentGrid.tsx';
import SearchModal from '../components/SearchModal.tsx';
import CartSidebar from '../components/CartSidebar.tsx';
import { VALID_TYPES, TYPE_CONFIG, ICONS } from '../lib/icons';
import { skillsPageMeta } from '../lib/list-page-meta';
import { TYPE_LABELS_RU } from '../lib/ru';
import counts from '../../public/counts.json';

export const prerender = true;

const TYPE_META: Record<string, { title: string; description: string; tagline: string; h1?: string }> = {
  skills: {
    ...skillsPageMeta((counts as Record<string, number>).skills),
    tagline: 'Готовые шаблоны и конфигурации, чтобы прокачать работу с ИИ'
  },
  agents: {
    title: '600+ ИИ-агентов для Claude Code: разработка, безопасность, DevOps',
    description: '600+ специализированных ИИ-агентов для Claude Code: фронтенд, бэкенд, безопасность, DevOps, data science и другое. Установка одной командой npx.',
    tagline: 'Специализированные ИИ-агенты для любых задач разработки'
  },
  commands: {
    title: '200+ слэш-команд для рабочих процессов в Claude Code',
    description: '200+ пользовательских слэш-команд для Claude Code: автоматизация тестирования, деплоя, код-ревью и не только. Установка одной командой npx.',
    tagline: 'Слэш-команды для автоматизации рабочих процессов'
  },
  settings: {
    title: 'Настройки Claude Code: 60+ шаблонов конфигурации',
    description: '60+ шаблонов конфигурации для Claude Code: строки состояния, разрешения, настройки модели и другое. Установка одной командой npx.',
    tagline: 'Шаблоны конфигурации для удобной настройки Claude Code'
  },
  hooks: {
    title: '39+ хуков Claude Code: триггеры и скрипты автоматизации',
    description: '39+ хуков автоматизации для Claude Code: Git-хуки, триггеры уведомлений и собственные скрипты. Установка одной командой npx.',
    tagline: 'Триггеры и скрипты автоматизации для бесшовной интеграции'
  },
  mcps: {
    title: '55+ MCP-интеграций для Claude Code: внешние сервисы',
    description: '55+ интеграций Model Context Protocol для Claude Code: подключение к базам данных, API и внешним сервисам. Установка одной командой npx.',
    tagline: 'Подключение к базам данных, API и внешним сервисам'
  },
  loops: {
    title: 'Циклы Claude Code: автономные агентные процессы (Loop Engineering)',
    description: 'Готовые агентные циклы для Claude Code. У каждого цикла есть цель, интервал и условие остановки, а внутри он объединяет агентов, скиллы и хуки. Установка одной командой npx.',
    tagline: 'Автономные агентные процессы, которые работают, пока задача не решена'
  },
  mods: {
    title: 'Моды Claude Code (Function Hooks): TypeScript-плагины, которые переписывают, запрещают, кэшируют и рисуют',
    description: 'Claude Mods для Claude Code: плагины на function hooks, TypeScript-middleware поверх интерфейса движка $. Блокируют опасные команды, скрывают секреты, кэшируют WebFetch, записывают каждое событие в аудит, рисуют в терминале. Доступно в Claude Code 2.1.287+.',
    tagline: 'Плагины на function hooks поверх интерфейса движка $. Включены по умолчанию в Claude Code 2.1.287+.'
  },
};


const { type } = Astro.params;
const activeType = type && VALID_TYPES.includes(type) ? type : 'skills';
const config = TYPE_CONFIG[activeType];
const meta = TYPE_META[activeType];
// Видимое название раздела (loops нет в общем словаре, он скрыт из меню).
const typeLabel = ({ ...TYPE_LABELS_RU, loops: 'Циклы' } as Record<string, string>)[activeType] ?? config?.label ?? activeType;

export function getStaticPaths() {
  return [
    { params: { type: 'skills' } },
    { params: { type: 'agents' } },
    { params: { type: 'commands' } },
    { params: { type: 'settings' } },
    { params: { type: 'hooks' } },
    { params: { type: 'mcps' } },
    { params: { type: 'loops' } },
    { params: { type: 'mods' } },
  ];
}
---

<DashboardLayout
  title={meta?.title ?? `${typeLabel} - Claude Code Templates`}
  description={meta?.description ?? `${typeLabel} для Claude Code. Установка одной командой npx.`}
>
  <TopBar />

  <!-- Premium Page Header -->
  <div class="relative overflow-hidden border-b border-[var(--color-border)] bg-gradient-to-b from-[var(--color-surface-0)] to-[var(--color-surface-1)]">
    <!-- Animated background gradient -->
    <div class="absolute inset-0 opacity-30">
      <div class="absolute inset-0 bg-gradient-to-br from-[var(--color-primary-500)]/10 via-transparent to-[var(--color-accent-400)]/10" style="animation: gradient-shimmer 8s ease infinite; background-size: 200% 200%;"></div>
    </div>
    
    <!-- Decorative elements -->
    <div class="absolute top-0 right-0 w-96 h-96 bg-gradient-to-br from-[var(--color-primary-500)]/5 to-transparent rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-gradient-to-tr from-[var(--color-accent-400)]/5 to-transparent rounded-full blur-3xl"></div>
    
    <div class="relative px-4 py-5 sm:px-6 sm:py-12 max-w-7xl mx-auto">
      <div class="flex items-center gap-4 sm:gap-6">
        <!-- Large icon -->
        <div 
          class="w-12 h-12 sm:w-20 sm:h-20 rounded-xl sm:rounded-2xl flex items-center justify-center shrink-0 shadow-2xl animate-float"
          style={`background: linear-gradient(135deg, ${config?.color ?? '#5e6ad2'}20 0%, ${config?.color ?? '#5e6ad2'}10 100%); border: 2px solid ${config?.color ?? '#5e6ad2'}30;`}
        >
          <div class="[&>svg]:w-6 [&>svg]:h-6 sm:[&>svg]:w-10 sm:[&>svg]:h-10" style={`color: ${config?.color ?? '#5e6ad2'}`} set:html={ICONS[activeType]} />
        </div>
        
        <div class="flex-1">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-2 mb-1 sm:mb-2">
            <h1 class="text-2xl sm:text-3xl font-bold text-[var(--color-text-primary)] tracking-tight">
              {meta?.h1 ?? typeLabel}
            </h1>
          </div>
          <p class="text-[13px] sm:text-[15px] text-[var(--color-text-secondary)] leading-relaxed max-w-2xl">
            {meta?.tagline ?? meta?.description}
          </p>
        </div>
      </div>
    </div>
  </div>
  

  <ComponentGrid client:load initialType={activeType} />
  <SearchModal client:idle />
  <CartSidebar client:idle />
</DashboardLayout>
